#!/usr/bin/env bash
# thread - bootstrap script for the githubToolkit adapter.
# Installs the 'congit' command into ~/.local/bin (on PATH) so it can be
# invoked from any opened terminal. Idempotent: re-running overwrites the
# wrapper and leaves it pointing at this adapter copy.
# Works on Linux, macOS and Git Bash (wrapper script, not a symlink).
set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VISE_ROOT="${VISE_ROOT:-$(cd "$ADAPTER_DIR/../.." && pwd)}"
STATE_DIR="$VISE_ROOT/.vise/state/github_toolkit"
BIN_DIR="$HOME/.local/bin"
SRC="$ADAPTER_DIR/bin/congit"

mkdir -p "$BIN_DIR" "$STATE_DIR"
chmod +x "$SRC"

# Write a small wrapper rather than a symlink: Git Bash/Windows does not
# always support POSIX symlinks without developer mode.
cat > "$BIN_DIR/congit" <<EOF
#!/usr/bin/env bash
# Auto-generated by githubToolkit thread - do not edit.
exec bash "$SRC" "\$@"
EOF
chmod +x "$BIN_DIR/congit"

# Record state
cat > "$STATE_DIR/state.json" <<EOF
{
  "adapter_id": "github_toolkit",
  "installed_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "command": "$BIN_DIR/congit",
  "target": "$SRC"
}
EOF

if command -v congit >/dev/null 2>&1; then
  echo "[thread] github_toolkit initialized: 'congit' is on PATH ($BIN_DIR/congit)"
else
  echo "[thread] github_toolkit initialized: wrapper written to $BIN_DIR/congit"
  echo "[thread] WARNING: $BIN_DIR is not on PATH in this shell."
  echo "          Add this to ~/.bashrc: export PATH=\"\$HOME/.local/bin:\$PATH\""
fi
