#!/usr/bin/env bash
# thread - bootstrap script for FastSearch.
set -euo pipefail

ADAPTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VISE_ROOT="${VISE_ROOT:-$(cd "$ADAPTER_DIR/../.." && pwd)}"
STATE_DIR="$VISE_ROOT/.vise/state/fast_search"
PYTHON_BIN="${PYTHON:-python3}"

mkdir -p "$STATE_DIR"
"$PYTHON_BIN" "$ADAPTER_DIR/src/fast_search/thread_cli.py" \
    --adapter-dir "$ADAPTER_DIR" \
    --state-dir "$STATE_DIR"

echo "[thread] fast_search initialized (state: $STATE_DIR)"
